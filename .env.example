# Copy to .env and set real values - docker-compose.yml has NO fallback for these three and refuses to
# start without them (a hardcoded default password in a repo is a password everyone has).
# Generate one each, e.g.: openssl rand -hex 24
# Use -hex, not -base64: these go unescaped into a postgresql://user:password@host URL, and a base64
# password's '/' or '+' breaks that URL's parsing (libpq ends up trying to resolve the password itself
# as a hostname). Hex output is plain [0-9a-f], always safe there.
POSTGRES_PASSWORD=
READONLY_PASSWORD=
ASSISTANT_RW_PASSWORD=
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Unset (default) = no auth, fine for local-only use behind the 127.0.0.1 port binding.
# Set to require `X-API-Key: <value>` on /chat and /documents/* once this is reachable beyond localhost.
API_KEY=
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_INGEST=10/minute
