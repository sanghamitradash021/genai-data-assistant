# Copy to .env to override defaults used by docker-compose.yml
POSTGRES_PASSWORD=development
READONLY_PASSWORD=rainbow
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Unset (default) = no auth, fine for local-only use behind the 127.0.0.1 port binding.
# Set to require `X-API-Key: <value>` on /chat and /documents/* once this is reachable beyond localhost.
API_KEY=
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_INGEST=10/minute
